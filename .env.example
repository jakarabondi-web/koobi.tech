# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — only .env.example is tracked.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL, used via Prisma) ---
DATABASE_URL="postgresql://trainora:trainora@localhost:5432/trainora_dev"

# --- Auth (Auth.js / NextAuth) ---
AUTH_SECRET="generate-a-32-byte-random-secret"
AUTH_URL="http://localhost:3000"
# Optional social login providers (mocked/disabled until configured)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Trainora AI <notifications@trainora.ai>"

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="trainora-uploads-dev"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Redis (queues, rate limiting, session cache) ---
REDIS_URL="redis://localhost:6379"

# --- Billing (client-facing, Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Trainer payouts (abstracted; pick one or more providers) ---
# Stripe Connect payouts reuse STRIPE_SECRET_KEY above. Without it, payouts
# are simulated and recorded with a `mock_stripe_` reference.
STRIPE_CONNECT_CLIENT_ID=""
WISE_API_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# M-Pesa (Safaricom Daraja B2C). All five are required for live payouts;
# without them payouts are simulated with a `mock_mpesa_` reference.
# Going live also needs a registered business shortcode and a B2C-enabled
# initiator account — these cannot be self-served.
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# --- Security ---
RATE_LIMIT_ENABLED="true"
FIELD_ENCRYPTION_KEY="generate-a-32-byte-random-secret"
